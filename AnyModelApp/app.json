{
  "expo": {
    "name": "ChatinShield",
    "slug": "chatinshield",
    "version": "1.5.0",
    "orientation": "portrait",
    "icon": "./assets/images/guardiip-logo.png",
    "scheme": "chatinshield",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "description": "A powerful AI chat assistant app that connects to multiple LLM providers including OpenAI, Anthropic Claude, and Ollama. Upload documents, chat with AI, and manage your conversations seamlessly.",
    "platforms": [
      "ios",
      "android"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.chatinshield.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "This app uses the camera to capture documents for AI analysis.",
        "NSPhotoLibraryUsageDescription": "This app accesses your photo library to select images for AI analysis.",
        "NSDocumentPickerUsageDescription": "This app accesses your documents to upload them for AI analysis.",
        "CFBundleURLTypes": [
          {
            "CFBundleURLName": "chatinshield",
            "CFBundleURLSchemes": [
              "chatinshield"
            ]
          }
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#007AFF"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.chatinshield.app",
      "versionCode": 1,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.INTERNET"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#007AFF"
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "newArchEnabled": true
          },
          "android": {
            "newArchEnabled": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "25a2e385-50cd-455d-9cde-3108a040dcda"
      }
    },
    "owner": "desoduce"
  }
}
