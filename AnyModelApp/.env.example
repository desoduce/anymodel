# AnyModel App Environment Variables
# Copy this file to .env and fill in your values

# Production API URL (optional - app works standalone without backend)
# Only needed if you want centralized document processing or PII filtering
EXPO_PUBLIC_API_URL=https://your-api-server.com

# Default LLM Provider (optional)
EXPO_PUBLIC_DEFAULT_PROVIDER=openrouter

# Analytics (optional)
# EXPO_PUBLIC_SENTRY_DSN=your-sentry-dsn-here
